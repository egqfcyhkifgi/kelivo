# Build X API Configuration
# Copy this file to .env and update with your actual values

# API Configuration
API_URL=https://premiere-geographic-telling-call.trycloudflare.com
MODEL_NAME=Build X
API_TIMEOUT=30000
MAX_TOKENS=4096

# Firebase Configuration (update with your Firebase project details)
# These values should be updated in firebase_options.dart as well
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-api-key
FIREBASE_APP_ID=your-app-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id